{
  "name": "neko-admin-web",
  "version": "1.0.0",
  "private": true,
  "description": "Panneau d'administration Neko — dashboard, serveurs, notes, planner",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3000",
    "lint": "eslint",
    "prisma:generate": "prisma generate --schema prisma/bot/schema.prisma && prisma generate --schema prisma/admin/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema prisma/admin/schema.prisma",
    "postinstall": "npm run prisma:generate"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "lucide-react": "^1.8.0",
    "next": "16.2.4",
    "next-auth": "^5.0.0-beta.31",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
